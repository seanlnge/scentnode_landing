---
---

<section class="section" aria-labelledby="product-heading">
	<div class="container grid-2">
		<div>
			<p class="section-label">The product</p>
			<h2 id="product-heading" class="heading-lg">Custom scent-enhanced packaging</h2>
			<p class="product__body">
				ScentNode pairs your brand or personal style with scent recommendations and packaging inserts
				that add a subtle olfactory layer to every delivery.
			</p>
			<ul class="feature-list">
				<li><span class="dot" aria-hidden="true"></span> Tailored scent direction based on identity and mood</li>
				<li><span class="dot" aria-hidden="true"></span> Scented inserts, cards, or packaging materials</li>
				<li><span class="dot" aria-hidden="true"></span> Premium implementation without full packaging redesign</li>
			</ul>
		</div>
		<div class="product__scene">
			<img
				class="product__photo"
				src="/images/kit.PNG"
				width="800"
				height="600"
				alt="The Nomad Kit — essence bottles, mixing tools, blending notes, and fragrance guide laid out"
				loading="lazy"
				decoding="async"
			/>
		</div>
	</div>
</section>

<style>
	.product__body {
		color: var(--muted);
		margin: 0 0 0.5rem;
		max-width: 32rem;
	}
	.product__scene {
		border-radius: var(--radius-lg, 1.75rem);
		background: linear-gradient(180deg, #faf7f4 0%, #ebe6de 100%);
		box-shadow:
			0 24px 60px rgba(28, 25, 23, 0.08),
			inset 0 1px 0 rgba(255, 255, 255, 0.9);
		overflow: hidden;
		padding: clamp(1rem, 3vw, 2rem);
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.product__photo {
		width: 100%;
		height: auto;
		object-fit: cover;
		border-radius: calc(var(--radius-lg, 1.75rem) - 0.5rem);
	}
</style>
