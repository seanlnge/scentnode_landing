---

<section class="section" aria-labelledby="experience-heading">
	<div class="container">
		<p class="section-label">Who it is for</p>
		<h2 id="experience-heading" class="heading-lg">
			One platform for premium brand packaging and personal gifting moments.
		</h2>
		<div class="exp-grid">
			<article class="card">
				<h3>For E-Commerce Brands</h3>
				<p>
					Designed for Shopify and direct-to-consumer teams that want stronger brand recall,
					premium presentation, and unboxing experiences that stand out from competitors.
				</p>
			</article>
			<article class="card">
				<h3>For Personal Senders</h3>
				<p>
					Ideal for gifts, letters, creator shipments, and personal mail that should feel warmer,
					more intimate, and tied to memory.
				</p>
			</article>
			<blockquote class="card-quote">
				<p>
					Scent turns ordinary packaging into a cinematic, emotional experience people remember.
				</p>
			</blockquote>
		</div>
	</div>
</section>

<style>
	.exp-grid {
		display: grid;
		gap: 1.25rem;
		margin-top: 2.5rem;
	}
	@media (min-width: 768px) {
		.exp-grid {
			grid-template-columns: 1fr 1fr;
			grid-template-rows: auto auto;
		}
		.card-quote {
			grid-column: 1 / -1;
		}
	}
</style>
