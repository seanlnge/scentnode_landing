---
---

<section class="hero section" id="top" aria-labelledby="hero-heading">
	<div class="hero__glow" aria-hidden="true"></div>
	<div class="container hero__grid">
		<div class="hero__copy">
		<h1 id="hero-heading" class="heading-xl">
			Scent-enhanced packaging,<br /><em class="hero__accent">for brands and personal senders</em>
		</h1>
			<p class="hero__lede">
				ScentNode helps businesses and individuals make unboxing moments feel premium, emotional,
				and memorable through custom scent recommendations and scented packaging inserts.
			</p>
			<div class="hero__actions">
				<a href="#waitlist" class="btn-pill btn-pill--terra">Join waitlist</a>
				<a href="#experience-heading" class="btn-pill hero__ghost">See how it works</a>
			</div>
			<div class="hero__meta">
				<p class="waitlist-caption">An overlooked competitive advantage for brands, and a memorable touch for personal mail.</p>
			</div>
		</div>
		<div class="hero__visual">
			<div class="hero__frame">
				<img
					class="hero__photo"
					src="/images/hero_bottle.png"
					width="800"
					height="1000"
					alt="ScentNode glass bottle"
					loading="eager"
					decoding="async"
				/>
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		padding-top: clamp(2rem, 5vw, 3rem);
	}
	.hero__glow {
		position: absolute;
		inset: -20% 20% auto -15%;
		height: 70%;
		background: radial-gradient(
			ellipse 80% 60% at 70% 20%,
			rgba(250, 212, 200, 0.65),
			transparent 70%
		);
		pointer-events: none;
	}
	.hero__grid {
		position: relative;
		display: grid;
		gap: clamp(2.25rem, 5vw, 4rem);
		align-items: center;
	}
	@media (min-width: 900px) {
		.hero__grid {
			grid-template-columns: 1fr 1fr;
		}
	}
	.hero__accent {
		color: var(--sage-text);
		font-style: italic;
	}
	.hero__lede {
		font-size: 1.15rem;
		color: var(--muted);
		max-width: 36rem;
		margin: 0 0 2rem;
		line-height: 1.65;
	}
	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem;
		align-items: center;
	}
	.hero__ghost {
		border: 1px solid rgba(28, 25, 23, 0.12);
		background: rgba(255, 255, 255, 0.72);
		color: var(--ink);
		box-shadow: 0 8px 30px rgba(28, 25, 23, 0.06);
	}
	.hero__meta {
		margin-top: 1rem;
	}
	.hero__visual {
		display: flex;
		justify-content: center;
		align-items: center;
		padding: 0.5rem;
	}
	.hero__frame {
		width: 100%;
		max-width: 22rem;
		aspect-ratio: 5 / 6;
		border-radius: var(--radius-lg, 1.75rem);
		background: linear-gradient(
			155deg,
			#fce8e0 0%,
			#f9f7f2 42%,
			#edd8cf 100%
		);
		box-shadow:
			0 28px 64px rgba(28, 25, 23, 0.1),
			inset 0 1px 0 rgba(255, 255, 255, 0.7);
		display: flex;
		align-items: center;
		justify-content: center;
		padding: clamp(1.25rem, 3.5vw, 2.25rem);
		overflow: hidden;
	}
	.hero__photo {
		width: 100%;
		height: 100%;
		object-fit: contain;
		object-position: center;
		filter: drop-shadow(0 12px 28px rgba(146, 84, 61, 0.15));
	}
</style>
