<section class="section section--beige" aria-labelledby="ritual-heading">
	<div class="container">
		<h2 id="ritual-heading" class="heading-lg ritual__title">The Ritual</h2>
		<div class="step-stack">
			<div class="step-card step-card--light">
				<div class="step-num">01</div>
				<h3>Sign up</h3>
				<p>Join our global community of nomad perfumers.</p>
			</div>
			<div class="step-card step-card--accent">
				<div class="step-num">02</div>
				<h3>Design for free</h3>
				<p>An AI intelligence engine to discover and create scent formulas.</p>
			</div>
			<div class="step-card step-card--light">
				<div class="step-num">03</div>
				<h3>Start blending</h3>
				<p>Receive your bespoke kit and start your fragrance journey.</p>
			</div>
		</div>
	</div>
</section>

<style>
	.ritual__title {
		text-align: center;
		margin-bottom: 2.5rem;
	}
</style>
