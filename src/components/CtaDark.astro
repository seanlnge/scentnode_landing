<section class="cta-dark section" id="waitlist" aria-labelledby="cta-heading">
	<div class="container">
		<h2 id="cta-heading" class="heading-xl cta-dark__title">
			Find the scent that feels like your memory.
		</h2>
		<p class="cta-dark__lede">
			Start with a few sensory cues, get your accord blend, then save it with your waitlist signup.
		</p>
		<div class="waitlist-block waitlist-block--center">
			<a href="/discover" class="btn-pill btn-pill--peach cta-dark__submit">
				Start the scent finder
			</a>
			<p class="waitlist-caption cta-dark__caption">
				Join 200+ people already exploring the waitlist.
			</p>
		</div>
	</div>
</section>

<style>
	.cta-dark {
		background: #141211;
		color: var(--white);
		text-align: center;
		padding-block: clamp(4rem, 10vw, 6rem);
	}
	.cta-dark__title {
		color: var(--white);
		margin-bottom: 1rem;
		max-width: 20ch;
		margin-inline: auto;
	}
	.cta-dark__lede {
		color: rgba(255, 255, 255, 0.72);
		max-width: 34rem;
		margin: 0 auto 2rem;
	}
	.waitlist-block--center {
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	.cta-dark__caption {
		color: rgba(255, 255, 255, 0.45);
	}
	.cta-dark__submit {
		font-size: 0.72rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}
</style>
