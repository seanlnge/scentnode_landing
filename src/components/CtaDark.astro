---
---

<section class="cta-dark section" id="waitlist" aria-labelledby="cta-heading">
	<div class="container">
		<h2 id="cta-heading" class="heading-xl cta-dark__title">
			Elevate every package with scent.
		</h2>
		<p class="cta-dark__lede">
			Join the ScentNode waitlist at scentnode.com and turn unboxing into a sensory advantage your
			customers remember.
		</p>
		<div class="waitlist-block waitlist-block--center" data-waitlist-wrap>
			<form class="waitlist-form waitlist-form--bare" data-waitlist-form data-source="cta-dark">
				<label class="sr-only" for="email-cta">Email</label>
				<input
					id="email-cta"
					type="email"
					name="email"
					required
					autocomplete="email"
					placeholder="you@example.com"
				/>
				<button type="submit" class="btn-pill btn-pill--peach cta-dark__submit">Join waitlist</button>
				<p data-waitlist-message role="status"></p>
			</form>
			<p class="waitlist-caption cta-dark__caption">Built for modern brands and personal creators.</p>
		</div>
	</div>
</section>

<style>
	.cta-dark {
		background: #141211;
		color: var(--white);
		text-align: center;
		padding-block: clamp(4rem, 10vw, 6rem);
	}
	.cta-dark__title {
		color: var(--white);
		margin-bottom: 1rem;
		max-width: 20ch;
		margin-inline: auto;
	}
	.cta-dark__lede {
		color: rgba(255, 255, 255, 0.72);
		max-width: 34rem;
		margin: 0 auto 2rem;
	}
	.waitlist-block--center {
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	.cta-dark .waitlist-form {
		margin-inline: auto;
	}
	.cta-dark .waitlist-form [data-waitlist-message] {
		text-align: center;
	}
	.cta-dark__caption {
		color: rgba(255, 255, 255, 0.45);
	}
	.cta-dark__submit {
		font-size: 0.72rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}
</style>
