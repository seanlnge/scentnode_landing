---
interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
}

const canonicalUrl = 'https://scentnode.com';

const {
	title = 'ScentNode — Custom fragrance kits for modern nomads',
	description = 'Design your dream fragrance with scent intelligence. Sign up, blend for free, and we\u2019ll send you everything to build it.',
	ogImage = '/images/opengraph.png',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/x-icon" href="/images/logo.ico" />
		<link rel="apple-touch-icon" href="/images/logo.PNG" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#f9f7f2" />
		<title>{title}</title>

		<!-- OpenGraph -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={`${canonicalUrl}${ogImage}`} />
		<meta property="og:site_name" content="ScentNode" />

		<!-- Twitter / X -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${canonicalUrl}${ogImage}`} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Figtree:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<meta name="p:domain_verify" content="468fda724520ff820aa3dfdf74aa7015"/>
	</head>
	<body>
		<slot />
	</body>
</html>
